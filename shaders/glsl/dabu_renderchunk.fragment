// __multiversion__
// This signals the loading code to prepend either #version 100 or #version 300 es as appropriate.

#include "fragmentVersionCentroid.h"
#include "dabu_apply.h"

#if __VERSION__ >= 300
	#ifndef BYPASS_PIXEL_SHADER
		#if defined(TEXEL_AA) && defined(TEXEL_AA_FEATURE)
			_centroid in highp vec2 uv0;
			_centroid in highp vec2 uv1;
		#else
			_centroid in vec2 uv0;
			_centroid in vec2 uv1;
		#endif
		_centroid in vec4 chupos;
		_centroid in vec3 v_worldpos;
	#endif
#else
	#ifndef BYPASS_PIXEL_SHADER
		varying vec2 uv0;
		varying vec2 uv1;
		varying vec4 chupos;
		varying vec3 v_worldpos;
	#endif
#endif

varying vec4 color;

#ifdef FOG
varying vec4 fogColor;
#endif

#include "uniformShaderConstants.h"
#include "util.h"

LAYOUT_BINDING(0) uniform sampler2D TEXTURE_0;
LAYOUT_BINDING(1) uniform sampler2D TEXTURE_1;
LAYOUT_BINDING(2) uniform sampler2D TEXTURE_2;

void main()
{
#ifdef BYPASS_PIXEL_SHADER
    gl_FragColor = vec4(0.0, 0.0, 0.0, 0.0);
    return;
#else

#if USE_TEXEL_AA
    vec4 diffuse = texture2D_AA(TEXTURE_0, uv0);
#else
    vec4 diffuse = texture2D(TEXTURE_0, uv0);
#endif

#ifdef SEASONS_FAR
    diffuse.a = 1.0;
#endif

    bool needDiscard = false;
#if USE_ALPHA_TEST
    #ifdef ALPHA_TO_COVERAGE
        #define ALPHA_THRESHOLD 0.05
    #else
        #define ALPHA_THRESHOLD 0.5
    #endif
    if(diffuse.a < ALPHA_THRESHOLD)
        needDiscard = true;
#endif

    vec4 inColor = color;

#ifdef ORE_TEST
    bool isOre = false;
    #if __VERSION__ >= 300
        vec4 oreTest = textureLod(TEXTURE_0, uv0, 0.0);
    #else
        vec4 oreTest = diffuse;
    #endif
    if (oreTest.a > 0.988 && oreTest.a < 0.993) {
        isOre = true;
        vec3 glow = oreTest.rgb * oreTest.rgb;
        if (oreTest.a > 0.989) {
            glow *= 0.4;
        }
        diffuse.rgb = diffuse.rgb * inColor.rgb;
        diffuse.rgb *= (2.0 - inColor.rgb);
        diffuse.rgb += glow * 0.5;
        #if __VERSION__ >= 300
            diffuse.rgb *= 0.4 + 0.625 * textureLod(TEXTURE_1, uv1, 0.0).rgb;
        #else
            diffuse.rgb *= 0.4 + 0.625 * texture2D(TEXTURE_1, uv1).rgb;
        #endif
    }
#endif

    if (!isOre) {
        #if defined(BLEND)
            diffuse.a *= inColor.a;
        #endif

        #if !defined(ALWAYS_LIT)
            diffuse *= texture2D( TEXTURE_1, uv1 );
        #endif

        #ifndef SEASONS
            #if !USE_ALPHA_TEST && !defined(BLEND)
                diffuse.a = inColor.a;
            #endif
            diffuse.rgb *= inColor.rgb;
        #else
            vec2 uv = inColor.xy;
            diffuse.rgb *= mix(vec3(1.0,1.0,1.0), texture2D( TEXTURE_2, uv).rgb*2.0, inColor.b);
            diffuse.rgb *= inColor.aaa;
            diffuse.a = 1.0;
        #endif
    } else {
        #if defined(BLEND)
            diffuse.a *= inColor.a;
        #endif
        #ifdef SEASONS
            diffuse.a = 1.0;
        #endif
    }

#if defined(REDSTONE_POWER) || defined(LIGHT_OVERLAY)
    bool isRedstoneDust = false;
    int isLightOverlay = 0;

    vec3 dX = dFdx(chupos.xyz);
    vec3 dY = dFdy(chupos.xyz);
    vec3 normal = normalize(cross(dX, dY));

    if (normal.y > 0.99) {
        vec3 cp = fract(chupos.xyz);
        cp.x = cp.x * 3.0 - 1.1;
        cp.z = cp.z * 3.0 - 1.1;

        #ifdef REDSTONE_POWER
            #if defined(ALPHA_TEST) && !defined(SEASONS) && !defined(SEASONS_FAR) && !defined(BLEND)
                red_stone_level(needDiscard, isRedstoneDust, diffuse, cp, inColor.rgb);
            #endif
        #endif

        #ifdef LIGHT_OVERLAY
            if (!isRedstoneDust && length(v_worldpos) < 48.0) {
                light_overlay(needDiscard, isLightOverlay, cp, uv1);
            }
        #endif
    }
#endif

#ifdef LIGHT_OVERLAY
    if (isLightOverlay == 1) {
        diffuse.rgb = mix(diffuse.rgb, vec3(0.0, 1.0, 0.0), 0.3);
    } else if (isLightOverlay == 2) {
        diffuse.rgb = mix(diffuse.rgb, vec3(1.0, 0.0, 0.0), 0.15);
    } else if (isLightOverlay == 3) {
        diffuse.rgb = mix(diffuse.rgb, vec3(0.1, 0.1, 1.0), 0.2);
    } else if (isLightOverlay == 4) {
        diffuse.rgb = mix(diffuse.rgb, vec3(0.0, 0.5, 1.0), 0.4);
    } else if (isLightOverlay == 5) {
        diffuse.rgb = mix(diffuse.rgb, vec3(0.85, 0.64, 0.07), 0.4);
    }
#endif

#if USE_ALPHA_TEST
    if (needDiscard)
        discard;
#endif

#ifdef CHUNK_BOUND
    if (length(v_worldpos) < 48.0) {
        diffuse.rgb = render_chunk_bound(diffuse.rgb, chupos.xyz);
    }
#endif

#ifdef FOG
    diffuse.rgb = mix( diffuse.rgb, fogColor.rgb, fogColor.a );
#endif

    gl_FragColor = diffuse;

#endif // BYPASS_PIXEL_SHADER
}