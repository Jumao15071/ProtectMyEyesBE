{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "minecraft:vibration_signal",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/vibration_signal"
			}
		},
		//感谢@邹陈云飞Zouchenyunfei提供的粒子指导
		"events": {
			"signal_trail": {
				"particle_effect": {
					"effect": "minecraft:vibration_signal_trail",
					"type": "particle_with_velocity"
				}
			}
		},
		"components": {
			"minecraft:particle_lifetime_events": {
				"timeline": {
					"0.05": "signal_trail",
					"0.10": "signal_trail",
					"0.15": "signal_trail",
					"0.20": "signal_trail",
					"0.25": "signal_trail",
					"0.30": "signal_trail",
					"0.35": "signal_trail",
					"0.40": "signal_trail",
					"0.45": "signal_trail",
					"0.50": "signal_trail",
					"0.55": "signal_trail",
					"0.60": "signal_trail",
					"0.65": "signal_trail",
					"0.70": "signal_trail",
					"0.75": "signal_trail"
				}
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.15
			},
			"minecraft:emitter_shape_point": {
				"direction": [ "variable.direction.x", "variable.direction.y", "variable.direction.z" ]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "(variable.max_lifetime - 0.05)" //避免粒子透过感测体
			},
			"minecraft:particle_initial_speed": "variable.particle_initial_speed",
			"minecraft:particle_motion_dynamic": { },
			"minecraft:particle_motion_parametric": {
				"rotation": -90
			},
			"minecraft:particle_appearance_billboard": {
				"size": [ 0.25, 0.25 ],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 18,
					"texture_height": 126,
					"flipbook": {
						"base_UV": [ 0, 0 ],
						"size_UV": [ 18, 18 ],
						"step_UV": [ 0, 18 ],
						"frames_per_second": 20,
						"max_frame": 7,
						"loop": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [ 1, 1, 1, 1 ]
			}
		}
	}
}